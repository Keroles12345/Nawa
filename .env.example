# Local development values only. Replace all secrets before any production deployment.
PORT=4000
NODE_ENV=development
STORAGE_MODE=prisma
POSTGRES_USER=nawa
POSTGRES_PASSWORD=localOnlyChangeThisPassword123
POSTGRES_DB=ecommerce
DATABASE_URL="******localhost:5432/ecommerce?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="local-only-change-this-to-a-random-secret-with-at-least-32-characters"
JWT_REFRESH_SECRET="local-only-use-a-different-random-secret-of-at-least-32-characters"
INTERNAL_API_KEY="local-only-change-this-to-a-random-api-key-of-at-least-32-characters"
ADMIN_NAME="Store Admin"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
CORS_ORIGIN="http://localhost:3000"
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL="info"
EMBEDDING_API_URL="https://api.openai.com/v1/embeddings"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
